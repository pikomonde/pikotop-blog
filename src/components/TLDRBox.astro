---
interface Props {
  class?: string;
}
---

<aside class:list={['tldr-box', Astro.props.class]}>
  <span class="tldr-label">TL;DR</span>
  <div class="tldr-content">
    <slot />
  </div>
</aside>

<style>
  .tldr-box {
    background: var(--bg2);
    border-left: 3px solid var(--accent);
    border-radius: 0 8px 8px 0;
    padding: 1.25rem 1.5rem 0.25rem 1.5rem;
    margin: 0 0 2rem 0;
  }

  .tldr-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .tldr-content {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text2);
  }

  /* Inline code inside TL;DR */
  .tldr-content :global(code) {
    background: var(--bg3);
    font-size: 0.88em;
  }
</style>

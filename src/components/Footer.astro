				</a>
			</div>
			<span class="footer-copy">&copy; {today.getFullYear()} PikoMo Blog</span>
		</div>
	</div>
</footer>

<style>
	footer {
		padding: 2rem 1.5rem;
		background: var(--bg);
		border-top: 0.5px solid var(--border);
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}

	.footer-inner {
		max-width: 900px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 2rem;
	}

	/* ── Left ── */
	.footer-brand-col {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	.footer-brand {
		font-size: 14px;
		font-weight: 600;
		color: var(--text);
		text-decoration: none;
	}
	.footer-brand:hover {
		color: var(--accent);
	}

	.footer-tagline {
		font-size: 11px;
		color: var(--text3);
	}

	/* ── Center ── */
	.footer-nav {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
	}

	.footer-link {
		font-size: 12px;
		color: var(--text2);
		text-decoration: none;
		transition: color 0.15s;
	}
	.footer-link:hover {
		color: var(--accent);
	}

	/* ── Right ── */
	.footer-right {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 6px;
	}

	.footer-socials {
		display: flex;
		gap: 10px;
	}

	.footer-social-link {
		color: var(--text3);
		display: flex;
		align-items: center;
		transition: color 0.15s;
	}
	.footer-social-link:hover {
		color: var(--accent);
	}

	.footer-copy {
		font-size: 11px;
		color: var(--text3);
	}

	/* ── Mobile ── */
	@media (max-width: 600px) {
		.footer-inner {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.footer-nav {
			align-items: flex-start;
			flex-direction: row;
			gap: 1rem;
		}

		.footer-right {
			align-items: flex-start;
		}
	}
</style>
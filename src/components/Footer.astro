---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<span class="footer-brand">Piko Monde</span>
		<span class="footer-copy">&copy; {today.getFullYear()} Piko Monde. All rights reserved.</span>
	</div>
</footer>

<style>
	footer {
		padding: 2rem 1.5rem;
		background: var(--bg);
		border-top: 0.5px solid var(--border);
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}

	.footer-inner {
		max-width: 900px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.footer-brand {
		font-size: 14px;
		font-weight: 500;
		color: var(--text);
	}

	.footer-copy {
		font-size: 12px;
		color: var(--text3);
	}

	@media (max-width: 720px) {
		.footer-inner {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.25rem;
		}
	}
</style>
---
import { SITE_TITLE } from '../consts';
---

<header>
	<a href="/" class="logo">{SITE_TITLE}</a>
	<button class="dark-toggle" id="dark-toggle" aria-label="Toggle dark mode">
		<div class="knob-track">
			<div class="knob-dot"></div>
		</div>
		<span class="toggle-label" id="toggle-label">Light</span>
	</button>
</header>

<style>
	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 1.5rem;
		background: var(--bg);
		border-bottom: 0.5px solid var(--border);
		position: sticky;
		top: 0;
		z-index: 50;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}

	.logo {
		font-size: 17px;
		font-weight: 500;
		color: var(--text);
		text-decoration: none;
	}
	.logo:hover {
		color: var(--accent);
	}

	.dark-toggle {
		display: flex;
		align-items: center;
		gap: 8px;
		cursor: pointer;
		background: var(--toggle-bg);
		border: 0.5px solid var(--border);
		border-radius: 20px;
		padding: 5px 12px 5px 6px;
		color: var(--text2);
		font-size: 12px;
		font-family: inherit;
		user-select: none;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}
	.dark-toggle:hover {
		border-color: var(--border2);
	}

	.knob-track {
		width: 28px;
		height: 16px;
		background: var(--bg);
		border: 0.5px solid var(--border2);
		border-radius: 10px;
		position: relative;
		flex-shrink: 0;
		transition: background-color 0.2s ease;
	}

	.knob-dot {
		position: absolute;
		top: 2px;
		left: 2px;
		width: 10px;
		height: 10px;
		background: var(--toggle-dot);
		border-radius: 50%;
		transition: transform 0.2s ease, background-color 0.2s ease;
	}

	:global(html.dark) .knob-dot {
		transform: translateX(12px);
	}
</style>

<script>
	const html = document.documentElement;
	const toggle = document.getElementById('dark-toggle');
	const label = document.getElementById('toggle-label');

	// Restore preference from localStorage
	const saved = localStorage.getItem('theme');
	if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
		html.classList.add('dark');
		if (label) label.textContent = 'Dark';
	}

	toggle?.addEventListener('click', () => {
		const isDark = html.classList.toggle('dark');
		if (label) label.textContent = isDark ? 'Dark' : 'Light';
		localStorage.setItem('theme', isDark ? 'dark' : 'light');
	});
</script>
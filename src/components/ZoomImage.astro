---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  caption?: string;
}

const { src, alt, width = 1200, height = 630, caption } = Astro.props;
const id = Math.random().toString(36).slice(2, 8);
---

<figure>
  <div
    class="zi-trigger"
    id={`zi-trigger-${id}`}
    role="button"
    tabindex="0"
    aria-label={`Zoom: ${alt}`}
  >
    <Image {src} {alt} {width} {height} />
    <span class="zi-hint">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35M11 8v6M8 11h6"/></svg>
      Click to zoom
    </span>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<!-- Lightbox — one per page, with unique ID, so it is safe to use it multiple times -->
<div class="zi-overlay" id={`zi-overlay-${id}`} role="dialog" aria-modal="true" aria-label="Image zoom">
  <button class="zi-close" id={`zi-close-${id}`} aria-label="Tutup">✕</button>

  <div class="zi-canvas" id={`zi-canvas-${id}`}>
    <img id={`zi-img-${id}`} src="" alt="" draggable="false" />
  </div>

  <div class="zi-toolbar">
    <button class="zi-tb-btn" id={`zi-out-${id}`}  aria-label="Zoom out">−</button>
    <span   class="zi-tb-label" id={`zi-lbl-${id}`}>100%</span>
    <button class="zi-tb-btn" id={`zi-in-${id}`}   aria-label="Zoom in">+</button>
    <div class="zi-sep"></div>
    <button class="zi-tb-btn" id={`zi-rst-${id}`}  aria-label="Reset">⟳</button>
  </div>
</div>

<style>
  /* ─── Trigger ── */
  .zi-trigger {
    position: relative;
    display: inline-block;
    width: 100%;
    cursor: zoom-in;
  }
  .zi-trigger img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: var(--box-shadow);
  }
  .zi-hint {
    position: absolute;
    bottom: 10px; right: 12px;
    background: rgba(0,0,0,0.55);
    color: #fff;
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 6px;
    display: flex; align-items: center; gap: 5px;
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
  }
  .zi-trigger:hover .zi-hint { opacity: 1; }

  /* ─── Overlay ── */
  .zi-overlay {
    display: none;
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.88);
    z-index: 9999;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .zi-overlay.open { display: flex; }

  /* ─── Canvas (zoomable area) ── */
  .zi-canvas {
    position: relative;
    overflow: hidden;
    width: 92vw;
    height: 82vh;
    cursor: grab;
    touch-action: none;
  }
  .zi-canvas.dragging { cursor: grabbing; }
  .zi-canvas img {
    position: absolute;
    top: 0; left: 0;
    transform-origin: 0 0;
    user-select: none;
    pointer-events: none;
    max-width: none;
    border-radius: 0;
    box-shadow: none;
  }

  /* ─── Toolbar ── */
  .zi-toolbar {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    background: rgba(255,255,255,0.1);
    border-radius: 10px;
    padding: 6px 10px;
  }
  .zi-tb-btn {
    background: rgba(255,255,255,0.15);
    border: none;
    color: #fff;
    width: 32px; height: 32px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 18px;
    line-height: 1;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.15s;
  }
  .zi-tb-btn:hover  { background: rgba(255,255,255,0.28); }
  .zi-tb-btn:active { background: rgba(255,255,255,0.38); }
  .zi-tb-label {
    color: rgba(255,255,255,0.8);
    font-size: 12px;
    min-width: 42px;
    text-align: center;
    font-family: var(--font-atkinson), monospace;
  }
  .zi-sep { width: 1px; height: 20px; background: rgba(255,255,255,0.2); }

  /* ─── Close button ── */
  .zi-close {
    position: absolute;
    top: 16px; right: 18px;
    background: rgba(255,255,255,0.15);
    border: none; color: #fff;
    font-size: 18px;
    width: 36px; height: 36px;
    border-radius: 50%;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.15s;
    z-index: 1;
  }
  .zi-close:hover { background: rgba(255,255,255,0.3); }
</style>

<script define:vars={{ id }}>
  (function () {
    const trigger  = document.getElementById(`zi-trigger-${id}`);
    const overlay  = document.getElementById(`zi-overlay-${id}`);
    const canvas   = document.getElementById(`zi-canvas-${id}`);
    const img      = document.getElementById(`zi-img-${id}`);
    const label    = document.getElementById(`zi-lbl-${id}`);
    const closeBtn = document.getElementById(`zi-close-${id}`);
    const btnIn    = document.getElementById(`zi-in-${id}`);
    const btnOut   = document.getElementById(`zi-out-${id}`);
    const btnRst   = document.getElementById(`zi-rst-${id}`);

    let scale = 1, tx = 0, ty = 0;
    const MIN = 0.2, MAX = 8;
    let dragging = false, lastX = 0, lastY = 0;
    let lastPinchDist = 0;

    function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

    function applyTransform() {
      img.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
      label.textContent = Math.round(scale * 100) + '%';
    }

    function centerImage() {
      const cw = canvas.clientWidth, ch = canvas.clientHeight;
      const nw = img.naturalWidth  || cw;
      const nh = img.naturalHeight || ch;
      const fit = Math.min(cw / nw, ch / nh, 1);
      scale = fit;
      tx = (cw - nw * fit) / 2;
      ty = (ch - nh * fit) / 2;
      applyTransform();
    }

    function zoomAt(cx, cy, factor) {
      const ns = clamp(scale * factor, MIN, MAX);
      const r  = ns / scale;
      tx = cx - r * (cx - tx);
      ty = cy - r * (cy - ty);
      scale = ns;
      applyTransform();
    }

    function open() {
      const srcImg = trigger.querySelector('img');
      if (!srcImg) return;
      img.src = srcImg.src;
      img.alt = srcImg.alt;
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
      if (img.complete && img.naturalWidth) centerImage();
      else img.onload = centerImage;

      // ── Tracking ──
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
          'event': 'zoom_image',
          'image_alt': srcImg.alt || 'no-alt',
          'page_title': document.title
      });
    }

    function close() {
      overlay.classList.remove('open');
      document.body.style.overflow = '';
    }

    // ── Open / close ──
    trigger.addEventListener('click', open);
    trigger.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') open(); });
    closeBtn.addEventListener('click', close);
    overlay.addEventListener('click', e => { if (e.target === overlay) close(); });
    document.addEventListener('keydown', e => {
      if (!overlay.classList.contains('open')) return;
      if (e.key === 'Escape') close();
      const r = canvas.getBoundingClientRect();
      const cx = r.width / 2, cy = r.height / 2;
      if (e.key === '+' || e.key === '=') zoomAt(cx, cy, 1.3);
      if (e.key === '-') zoomAt(cx, cy, 1 / 1.3);
      if (e.key === '0') centerImage();
    });

    // ── Toolbar buttons ──
    btnIn.addEventListener('click',  () => { const r = canvas.getBoundingClientRect(); zoomAt(r.width/2, r.height/2, 1.3); });
    btnOut.addEventListener('click', () => { const r = canvas.getBoundingClientRect(); zoomAt(r.width/2, r.height/2, 1/1.3); });
    btnRst.addEventListener('click', centerImage);

    // ── Mouse wheel ──
    canvas.addEventListener('wheel', e => {
      e.preventDefault();
      const r = canvas.getBoundingClientRect();
      zoomAt(e.clientX - r.left, e.clientY - r.top, e.deltaY < 0 ? 1.15 : 1 / 1.15);
    }, { passive: false });

    // ── Mouse drag ──
    canvas.addEventListener('mousedown', e => {
      dragging = true; lastX = e.clientX; lastY = e.clientY;
      canvas.classList.add('dragging');
    });
    window.addEventListener('mousemove', e => {
      if (!dragging) return;
      tx += e.clientX - lastX; ty += e.clientY - lastY;
      lastX = e.clientX; lastY = e.clientY;
      applyTransform();
    });
    window.addEventListener('mouseup', () => { dragging = false; canvas.classList.remove('dragging'); });

    // ── Touch: drag + pinch-to-zoom ──
    canvas.addEventListener('touchstart', e => {
      if (e.touches.length === 1) {
        dragging = true; lastX = e.touches[0].clientX; lastY = e.touches[0].clientY;
      } else if (e.touches.length === 2) {
        dragging = false;
        lastPinchDist = Math.hypot(
          e.touches[0].clientX - e.touches[1].clientX,
          e.touches[0].clientY - e.touches[1].clientY
        );
      }
    }, { passive: true });

    canvas.addEventListener('touchmove', e => {
      e.preventDefault();
      if (e.touches.length === 1 && dragging) {
        tx += e.touches[0].clientX - lastX;
        ty += e.touches[0].clientY - lastY;
        lastX = e.touches[0].clientX; lastY = e.touches[0].clientY;
        applyTransform();
      } else if (e.touches.length === 2) {
        const d = Math.hypot(
          e.touches[0].clientX - e.touches[1].clientX,
          e.touches[0].clientY - e.touches[1].clientY
        );
        const r  = canvas.getBoundingClientRect();
        const mx = (e.touches[0].clientX + e.touches[1].clientX) / 2 - r.left;
        const my = (e.touches[0].clientY + e.touches[1].clientY) / 2 - r.top;
        if (lastPinchDist) zoomAt(mx, my, d / lastPinchDist);
        lastPinchDist = d;
      }
    }, { passive: false });

    canvas.addEventListener('touchend', () => { dragging = false; lastPinchDist = 0; });
  })();
</script>

---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tagTopics, tagSeries, lang, publishedOn, author } = Astro.props;

const allPosts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

// ── Series ────────────────────────────────────────────────────────
// Count how many posts share this series, and find this post's position.

interface SeriesInfo {
	name: string;
	index: number;
	total: number;
}

const seriesList: SeriesInfo[] = (tagSeries ?? []).map((name) => {
	const postsInSeries = allPosts.filter((p) => p.data.tagSeries?.includes(name));
	const total = postsInSeries.length;
	const idx = postsInSeries.findIndex((p) => p.data.title === title);
	return { name, index: idx >= 0 ? idx + 1 : 1, total };
});

const hasSeries = seriesList.length > 0;

// ── Related / Recommended Posts ───────────────────────────────────
// Scoring priority: same series (10pts) > topic overlap (3pts each) > recency boost.
// Recency is based on position in the sorted allPosts array (most recent = last),
// so we reverse the array first to give index 0 = most recent post.

const others = allPosts
	.filter((p) => p.data.title !== title)
	.reverse(); // most recent first for recency scoring

const related = others
	.map((p, index) => {
		let score = 0;

		// Same series → highest priority
		if (p.data.tagSeries?.some((s) => tagSeries?.includes(s))) score += 5;

		// Topic tag overlap
		const overlap = p.data.tagTopics.filter((t) => tagTopics?.includes(t)).length;
		score += overlap * 3;

		// Recency boost: top 7 most recent posts get a small bump
		if (index < 7) score += (7 - index) * 1.5;

		return { post: p, score };
	})
	.sort((a, b) => b.score - a.score)
	.slice(0, 3)
	.map((s) => s.post);

// ── Published Entries ─────────────────────────────────────────────

const publishedEntries = Object.entries(publishedOn ?? {});

const initials = author
	.split(' ')
	.map((w: string) => w[0])
	.join('')
	.toUpperCase()
	.slice(0, 2);
---

<html lang={lang ?? 'en'}>
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			/* ─── Layout ─────────────────────────────────────────── */
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 2.5rem 1em 4rem;
			}

			/* ─── Back Button ────────────────────────────────────── */
			.back-btn {
				display: inline-flex;
				align-items: center;
				gap: 5px;
				color: var(--text2);
				font-size: 13px;
				cursor: pointer;
				margin-bottom: 1.75rem;
				border: none;
				background: none;
				padding: 0;
				font-family: inherit;
				text-decoration: none;
			}
			.back-btn:hover {
				color: var(--accent);
			}

			/* ─── Hero Image ─────────────────────────────────────── */
			.hero-image {
				width: 100%;
				margin-bottom: 1.75rem;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}

			/* ─── Series Bar ─────────────────────────────────────── */
			.series-bar {
				background: var(--series-bg);
				border-radius: 8px;
				padding: 0.6rem 1rem;
				margin-bottom: 1rem;
				display: flex;
				align-items: center;
				gap: 6px;
				flex-wrap: wrap;
			}
			.series-label {
				font-size: 12px;
				color: var(--series-text);
			}
			.series-link {
				font-size: 12px;
				color: var(--series-text);
				font-weight: 500;
				text-decoration: underline;
				text-underline-offset: 2px;
			}
			.series-link:hover {
				opacity: 0.8;
			}
			.series-part {
				font-size: 12px;
				color: var(--series-text);
				opacity: 0.7;
				margin-left: auto;
			}

			/* ─── Tags ───────────────────────────────────────────── */
			.article-tags {
				display: flex;
				gap: 5px;
				flex-wrap: wrap;
				margin-bottom: 10px;
			}
			.tag {
				font-size: 11px;
				padding: 2px 7px;
				border-radius: 4px;
			}
			.tag.topic {
				background: var(--tag-bg);
				color: var(--tag-text);
			}
			.lang-badge {
				background: var(--bg3);
				color: var(--text2);
				font-size: 11px;
				padding: 2px 7px;
				border-radius: 4px;
				font-weight: 500;
			}

			/* ─── Title ──────────────────────────────────────────── */
			.article-title {
				font-size: clamp(1.6rem, 4vw, 2.2rem);
				font-weight: 600;
				line-height: 1.25;
				margin-bottom: 1rem;
				color: var(--text);
			}

			/* ─── Meta Bar ───────────────────────────────────────── */
			.article-meta {
				display: flex;
				align-items: center;
				gap: 10px;
				flex-wrap: wrap;
				border-top: 0.5px solid var(--border);
				border-bottom: 0.5px solid var(--border);
				padding: 10px 0;
				margin-bottom: 2rem;
			}
			.avatar {
				width: 28px;
				height: 28px;
				border-radius: 50%;
				background: var(--tag-bg);
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 10px;
				font-weight: 500;
				color: var(--tag-text);
				flex-shrink: 0;
			}
			.meta-author {
				font-size: 13px;
				color: var(--text);
				font-weight: 500;
			}
			.meta-sep {
				color: var(--border2);
				font-size: 14px;
			}
			.meta-dates {
				font-size: 12px;
				color: var(--text2);
			}
			.meta-dates .upd {
				font-style: italic;
			}

			/* ─── Prose ──────────────────────────────────────────── */
			.prose {
				font-size: 17px;
				line-height: 1.8;
				color: var(--text);
			}
			.prose :global(p) {
				margin-bottom: 1.5rem;
			}
			.prose :global(h2),
			.prose :global(h3),
			.prose :global(h4) {
				margin-top: 2rem;
				margin-bottom: 0.75rem;
				color: var(--text);
			}
			.prose :global(a) {
				color: var(--accent);
			}
			.prose :global(img) {
				border-radius: 8px;
				max-width: 100%;
			}
			.prose :global(pre) {
				border-radius: 8px;
				overflow-x: auto;
			}
			.prose :global(blockquote) {
				border-left: 3px solid var(--accent);
				padding-left: 1rem;
				color: var(--text2);
				font-style: italic;
				line-height: 1.5;
				font-size: 0.95em;
			}

			/* ─── Published On ───────────────────────────────────── */
			.published-box {
				background: var(--bg2);
				border-radius: 8px;
				padding: 0.875rem 1.25rem;
				margin-top: 2.5rem;
			}
			.published-box-title {
				font-size: 12px;
				font-weight: 500;
				color: var(--text2);
				margin-bottom: 8px;
			}
			.pub-links {
				display: flex;
				gap: 8px;
				flex-wrap: wrap;
			}
			.pub-link {
				background: var(--pub-bg);
				color: var(--pub-text);
				font-size: 12px;
				padding: 4px 12px;
				border-radius: 6px;
				text-decoration: none;
				transition: opacity 0.15s;
			}
			.pub-link:hover {
				opacity: 0.8;
				color: var(--pub-text);
			}

			/* ─── Related Posts ──────────────────────────────────── */
			.related-section {
				margin-top: 3rem;
				padding-top: 2rem;
				border-top: 0.5px solid var(--border);
			}
			.related-title {
				font-size: 13px;
				font-weight: 500;
				color: var(--text2);
				text-transform: uppercase;
				letter-spacing: 0.06em;
				margin-bottom: 1rem;
			}
			.related-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
				gap: 0.875rem;
			}
			.related-card {
				background: var(--bg);
				border: 0.5px solid var(--border);
				border-radius: 10px;
				overflow: hidden;
				text-decoration: none;
				color: inherit;
				display: flex;
				flex-direction: column;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			.related-card:hover {
				border-color: var(--accent);
				box-shadow: 0 4px 16px rgba(35, 55, 255, 0.08);
			}
			.related-card.in-series {
				/* border-left: 3px solid var(--series-text); */
			}
			.related-img {
				width: 100%;
				/* aspect-ratio: 16 / 9; */
				overflow: hidden;
				background: var(--bg3);
				flex-shrink: 0;
			}
			.related-img img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				display: block;
			}
			.related-img-placeholder {
				width: 100%;
				height: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--text3);
				font-size: 10px;
			}
			.related-body {
				padding: 0.75rem;
				flex: 1;
				display: flex;
				flex-direction: column;
				gap: 4px;
			}
			.related-meta {
				display: flex;
				gap: 4px;
				flex-wrap: wrap;
			}
			.related-tag {
				font-size: 10px;
				padding: 1px 6px;
				border-radius: 3px;
			}
			.related-tag.topic {
				background: var(--tag-bg);
				color: var(--tag-text);
			}
			.related-tag.series {
				background: var(--series-bg);
				color: var(--series-text);
			}
			.related-post-title {
				font-size: 13px;
				font-weight: 500;
				line-height: 1.4;
				color: var(--text);
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.related-date {
				font-size: 11px;
				color: var(--text3);
				margin-top: auto;
			}

			/* ─── Responsive ─────────────────────────────────────── */
			@media (max-width: 720px) {
				.related-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<!-- Back to blog -->
			<a href="/" class="back-btn">← Back to blog</a>

			<!-- Hero Image -->
			{heroImage && (
				<div class="hero-image">
					<Image width={1200} height={630} src={heroImage} loading="eager" fetchpriority="high" alt="" />
				</div>
			)}

			<!-- Series Bar (only if has series) -->
			{hasSeries && seriesList.map((s) => (
				<div class="series-bar">
					<span class="series-label">Part of series:</span>
					<a
						class="series-link"
						href={`/?series=${encodeURIComponent(s.name)}`}
					>
						{s.name}
					</a>
					<span class="series-part">{s.index} of {s.total}</span>
				</div>
			))}
			<!-- Tags -->
			<div class="article-tags">
				{(tagTopics ?? []).map((t: string) => (
					<span class="tag topic">{t}</span>
				))}
				<span class="lang-badge">{(lang ?? 'en').toUpperCase()}</span>
			</div>

			<!-- Title -->
			<h1 class="article-title">{title}</h1>

			<!-- Meta: author + dates -->
			<div class="article-meta">
				<div class="avatar">{initials}</div>
				<span class="meta-author">{author}</span>
				<span class="meta-sep">·</span>
				<div class="meta-dates">
					<div>Published <FormattedDate date={pubDate} /></div>
					{updatedDate && (
						<div class="upd">Updated <FormattedDate date={updatedDate} /></div>
					)}
				</div>
			</div>

			<!-- Article Content -->
			<div class="prose">
				<slot />
				<hr />
				<div class="author-cta">
					<p>
						More projects on <a href="https://github.com/pikomonde" target="_blank" rel="noopener noreferrer">GitHub</a>
						· If this saved you some debugging time, <a href="https://ko-fi.com/pikomonde" target="_blank" rel="noopener noreferrer">Ko-fi</a> is always appreciated.
					</p>
				</div>
			</div>

			<!-- Also Published On (only if publishedOn has entries) -->
			{publishedEntries.length > 0 && (
				<div class="published-box">
					<div class="published-box-title">Also published on</div>
					<div class="pub-links">
						{publishedEntries.map(([name, url]) => (
							<a
								class="pub-link"
								href={url}
								target="_blank"
								rel="noopener noreferrer"
							>
								{name} →
							</a>
						))}
					</div>
				</div>
			)}

			<!-- Related / Recommended Posts -->
			{related.length > 0 && (
				<div class="related-section">
					<div class="related-title">Recommended</div>
					<div class="related-grid">
						{related.map((p) => {
							const hasSeries = p.data.tagSeries && p.data.tagSeries.length > 0;
							return (
								<a
									href={`/${p.id}/`}
									class:list={['related-card', { 'in-series': hasSeries }]}
								>
									<div class="related-img">
										{p.data.heroImage ? (
											<Image width={1200} height={630} src={p.data.heroImage} alt="" />
										) : (
											<div class="related-img-placeholder">No image</div>
										)}
									</div>
									<div class="related-body">
										<div class="related-meta">
											{hasSeries && p.data.tagSeries!.map((s: string) => (
												<span class="related-tag series">{s}</span>
											))}
											{p.data.tagTopics.slice(0, 2).map((t: string) => (
												<span class="related-tag topic">{t}</span>
											))}
										</div>
										<div class="related-post-title">{p.data.title}</div>
										<div class="related-date">
											<FormattedDate date={p.data.pubDate} />
										</div>
									</div>
								</a>
							);
						})}
					</div>
				</div>
			)}
		</main>
		<Footer />

		<script>
			// Scroll Depth Tracking
			(function() {
				const scrollMarks = new Set();
				window.addEventListener('scroll', () => {
					const scrolled = window.scrollY;
					const total = document.body.scrollHeight - window.innerHeight;
					if (total <= 0) return;
					const percent = Math.round((scrolled / total) * 100);
					[25, 50, 75, 90].forEach(mark => {
						if (percent >= mark && !scrollMarks.has(mark)) {
							scrollMarks.add(mark);
							(window as any).dataLayer = (window as any).dataLayer || [];
							(window as any).dataLayer.push({
								'event': 'scroll_depth',
								'scroll_percent': mark + '%',
								'page_title': document.title
							});
							(window as any).dataLayer.push({
								'scroll_percent': undefined,
								'page_title': undefined
							});
						}
					});
				}, { passive: true });
			})();
		</script>
		
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P8F5LQD2"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
	</body>
</html>